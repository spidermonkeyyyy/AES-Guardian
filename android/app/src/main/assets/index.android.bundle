      notes               TEXT,\n        created_at          TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        updated_at          TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","CREATE TABLE IF NOT EXISTS audit_events (\n        id          INTEGER PRIMARY KEY AUTOINCREMENT,\n        event_type  TEXT    NOT NULL,\n        user_id     INTEGER REFERENCES demo_users(id),\n        entity_type TEXT,\n        entity_id   INTEGER,\n        description TEXT    NOT NULL,\n        occurred_at TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )"]},{version:2,description:'Role model correction: replace SANAD roles with approved AES Guardian roles',up:["ALTER TABLE demo_users RENAME TO demo_users_v1","CREATE TABLE demo_users (\n        id           INTEGER PRIMARY KEY AUTOINCREMENT,\n        username     TEXT    NOT NULL UNIQUE,\n        display_name TEXT    NOT NULL,\n        role         TEXT    NOT NULL CHECK (role IN (\n                       'exposed_professional',\n                       'admin_reviewer',\n                       'oh_professional',\n                       'quality_staff',\n                       'tech_admin'\n                     )),\n        created_at   TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        updated_at   TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","INSERT INTO demo_users (id, username, display_name, role, created_at, updated_at)\n       SELECT id, username, display_name, role, created_at, updated_at\n       FROM demo_users_v1\n       WHERE role IN (\n         'exposed_professional','admin_reviewer','oh_professional','quality_staff','tech_admin'\n       )","DROP TABLE demo_users_v1","INSERT OR IGNORE INTO demo_users (username, display_name, role) VALUES\n        ('prof.demo.expose',  'Professionnel Expos\xe9 (D\xe9mo)',         'exposed_professional'),\n        ('admin.demo.review', 'Administrateur RH (D\xe9mo)',            'admin_reviewer'),\n        ('medecin.demo.sst',  'M\xe9decin du Travail (D\xe9mo)',           'oh_professional'),\n        ('qualite.demo',      'Responsable Qualit\xe9 (D\xe9mo)',          'quality_staff'),\n        ('admin.demo.tech',   'Administrateur Technique (D\xe9mo)',     'tech_admin')"]},{version:3,description:'Extended declaration schema: incident fields, submitted_at, indexes',up:["ALTER TABLE aes_declarations RENAME TO aes_declarations_v1","CREATE TABLE aes_declarations (\n        id                        INTEGER PRIMARY KEY AUTOINCREMENT,\n        reference_number          TEXT    NOT NULL UNIQUE,\n        declared_by_user_id       INTEGER NOT NULL REFERENCES demo_users(id),\n        incident_date             TEXT    NOT NULL,\n        incident_type             TEXT    NOT NULL DEFAULT 'other'\n                                    CHECK (incident_type IN (\n                                      'percutaneous_exposure',\n                                      'mucocutaneous_exposure',\n                                      'sexual_assault',\n                                      'other'\n                                    )),\n        circumstances             TEXT,\n        exposure_description      TEXT,\n        protective_measures_taken TEXT,\n        department_code           TEXT,\n        notes                     TEXT,\n        status                    TEXT    NOT NULL DEFAULT 'draft'\n                                    CHECK (status IN ('draft','submitted','under_review','closed')),\n        submitted_at              TEXT,\n        created_at                TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        updated_at                TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","DROP TABLE aes_declarations_v1","CREATE INDEX IF NOT EXISTS idx_aes_declarations_status\n         ON aes_declarations(status)","CREATE INDEX IF NOT EXISTS idx_aes_declarations_user\n         ON aes_declarations(declared_by_user_id)"]},{version:4,description:'Administrative reviews: table, outcomes, indexes, review queue tracking',up:["CREATE TABLE IF NOT EXISTS administrative_reviews (\n        id                  INTEGER PRIMARY KEY AUTOINCREMENT,\n        declaration_id      INTEGER NOT NULL REFERENCES aes_declarations(id),\n        reviewer_user_id    INTEGER NOT NULL REFERENCES demo_users(id),\n        outcome             TEXT    NOT NULL CHECK (outcome IN (\n                              'acknowledged',\n                              'transmission_verified',\n                              'correction_requested'\n                            )),\n        comments            TEXT,\n        correction_reason   TEXT,\n        reviewed_at         TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        created_at          TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","CREATE INDEX IF NOT EXISTS idx_admin_reviews_decl\n         ON administrative_reviews(declaration_id)","CREATE INDEX IF NOT EXISTS idx_admin_reviews_reviewer\n         ON administrative_reviews(reviewer_user_id)"]},{version:5,description:'Correction responses: table, indexes, and declaration status expansion for correction lifecycle',up:["CREATE TABLE aes_declarations_new (\n        id                        INTEGER PRIMARY KEY AUTOINCREMENT,\n        reference_number          TEXT    NOT NULL UNIQUE,\n        declared_by_user_id       INTEGER NOT NULL REFERENCES demo_users(id),\n        incident_date             TEXT    NOT NULL,\n        incident_type             TEXT    NOT NULL DEFAULT 'other'\n                                    CHECK (incident_type IN (\n                                      'percutaneous_exposure',\n                                      'mucocutaneous_exposure',\n                                      'sexual_assault',\n                                      'other'\n                                    )),\n        circumstances             TEXT,\n        exposure_description      TEXT,\n        protective_measures_taken TEXT,\n        department_code           TEXT,\n        notes                     TEXT,\n        status                    TEXT    NOT NULL DEFAULT 'draft'\n                                    CHECK (status IN (\n                                      'draft',\n                                      'submitted',\n                                      'under_review',\n                                      'correction_requested',\n                                      'resubmitted',\n                                      'closed'\n                                    )),\n        submitted_at              TEXT,\n        created_at                TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        updated_at                TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","INSERT INTO aes_declarations_new (\n        id, reference_number, declared_by_user_id, incident_date, incident_type,\n        circumstances, exposure_description, protective_measures_taken,\n        department_code, notes, status, submitted_at, created_at, updated_at\n      )\n      SELECT\n        id, reference_number, declared_by_user_id, incident_date, incident_type,\n        circumstances, exposure_description, protective_measures_taken,\n        department_code, notes, status, submitted_at, created_at, updated_at\n      FROM aes_declarations","DROP TABLE aes_declarations","ALTER TABLE aes_declarations_new RENAME TO aes_declarations","CREATE INDEX IF NOT EXISTS idx_aes_declarations_status\n         ON aes_declarations(status)","CREATE INDEX IF NOT EXISTS idx_aes_declarations_user\n         ON aes_declarations(declared_by_user_id)","CREATE TABLE IF NOT EXISTS correction_responses (\n        id                  INTEGER PRIMARY KEY AUTOINCREMENT,\n        declaration_id      INTEGER NOT NULL REFERENCES aes_declarations(id) ON DELETE CASCADE,\n        review_id           INTEGER NOT NULL UNIQUE REFERENCES administrative_reviews(id),\n        responding_user_id  INTEGER NOT NULL REFERENCES demo_users(id),\n        response_text       TEXT    NOT NULL,\n        responded_at        TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        created_at          TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","CREATE INDEX IF NOT EXISTS idx_corr_resp_decl\n         ON correction_responses(declaration_id)","CREATE INDEX IF NOT EXISTS idx_corr_resp_review\n         ON correction_responses(review_id)","CREATE INDEX IF NOT EXISTS idx_corr_resp_user\n         ON correction_responses(responding_user_id)"]},{version:6,description:'Occupational-health coordination records and follow-up events (Phase 2C.4)',up:["CREATE TABLE IF NOT EXISTS oh_coordinations (\n        id                      INTEGER PRIMARY KEY AUTOINCREMENT,\n        declaration_id          INTEGER NOT NULL REFERENCES aes_declarations(id),\n        created_by_user_id      INTEGER NOT NULL REFERENCES demo_users(id),\n        coordination_reason     TEXT    NOT NULL CHECK (coordination_reason IN (\n                                  'routine_followup', 'serology_monitoring',\n                                  'specialized_evaluation', 'other_coordination'\n                                )),\n        status                  TEXT    NOT NULL DEFAULT 'pending_acknowledgement'\n                                  CHECK (status IN (\n                                    'pending_acknowledgement', 'acknowledged',\n                                    'completed', 'cancelled'\n                                  )),\n        acknowledged_by_user_id INTEGER REFERENCES demo_users(id),\n        acknowledged_at         TEXT,\n        completed_by_user_id    INTEGER REFERENCES demo_users(id),\n        completed_at            TEXT,\n        created_at              TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        updated_at              TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","CREATE UNIQUE INDEX IF NOT EXISTS idx_oh_coord_active_per_decl\n         ON oh_coordinations(declaration_id)\n         WHERE status IN ('pending_acknowledgement', 'acknowledged')","CREATE INDEX IF NOT EXISTS idx_oh_coord_decl ON oh_coordinations(declaration_id)","CREATE INDEX IF NOT EXISTS idx_oh_coord_created_by ON oh_coordinations(created_by_user_id)","CREATE INDEX IF NOT EXISTS idx_oh_coord_status ON oh_coordinations(status)","CREATE TABLE IF NOT EXISTS oh_follow_up_events (\n        id                  INTEGER PRIMARY KEY AUTOINCREMENT,\n        coordination_id     INTEGER NOT NULL REFERENCES oh_coordinations(id),\n        event_category      TEXT    NOT NULL CHECK (event_category IN (\n                              'contact_attempt_recorded', 'contact_established',\n                              'appointment_coordinated', 'consultation_recorded',\n                              'follow_up_continued', 'follow_up_completed'\n                            )),\n        event_date          TEXT    NOT NULL,\n        recorded_by_user_id INTEGER NOT NULL REFERENCES demo_users(id),\n        administrative_note TEXT,\n        created_at          TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","CREATE INDEX IF NOT EXISTS idx_oh_event_coord ON oh_follow_up_events(coordination_id)","CREATE INDEX IF NOT EXISTS idx_oh_event_recorded_by ON oh_follow_up_events(recorded_by_user_id)"]},{version:7,description:'Prevention and corrective actions: register, lifecycle, contributing factors, indexes',up:["CREATE TABLE IF NOT EXISTS prevention_actions (\n        id                     INTEGER PRIMARY KEY AUTOINCREMENT,\n        reference_code         TEXT    NOT NULL UNIQUE,\n        title                  TEXT    NOT NULL,\n        description            TEXT    NOT NULL,\n        action_type            TEXT    NOT NULL CHECK (action_type IN ('corrective', 'preventive')),\n        contributing_factor    TEXT    NOT NULL CHECK (contributing_factor IN (\n                                 'device_safety_design',\n                                 'procedure_compliance',\n                                 'workload_fatigue',\n                                 'waste_disposal_container',\n                                 'protective_equipment',\n                                 'training_supervision',\n                                 'environment_workspace',\n                                 'other_factor'\n                               )),\n        rationale              TEXT    NOT NULL,\n        surveillance_reference TEXT,\n        status                 TEXT    NOT NULL DEFAULT 'proposed'\n                                 CHECK (status IN ('proposed', 'in_progress', 'completed', 'cancelled')),\n        target_date            TEXT,\n        completed_at           TEXT,\n        completion_notes       TEXT,\n        created_by_user_id     INTEGER NOT NULL REFERENCES demo_users(id),\n        created_at             TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n        updated_at             TEXT    NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\n      )","CREATE INDEX IF NOT EXISTS idx_prevention_status ON prevention_actions(status)","CREATE INDEX IF NOT EXISTS idx_prevention_action_type ON prevention_actions(action_type)","CREATE INDEX IF NOT EXISTS idx_prevention_factor ON prevention_actions(contributing_factor)","CREATE INDEX IF NOT EXISTS idx_prevention_created_by ON prevention_actions(created_by_user_id)"]},{version:8,description:'In-app notification system: notifications table, recipient scoping, idempotency, indexes',up:["CREATE TABLE IF NOT EXISTS in_app_notifications (\n        id                  INTEGER PRIMARY KEY AUTOINCREMENT,\n        recipient_user_id   INTEGER NOT NULL REFERENCES demo_users(id) ON DELETE CASCADE,\n        event_type          TEXT    NOT NULL CHECK (event_type IN (\n                            