44\u0627\u063a \u0648\u0627\u0639\u062a\u0645\u0627\u062f\u0647 \u0623\u0648 \u0637\u0644\u0628 \u062a\u0648\u0636\u064a\u062d\u0627\u062a.",'workspace.step3.title':"3. \u0627\u0633\u062a\u0643\u0645\u0627\u0644 \u0627\u0644\u062a\u0635\u062d\u064a\u062d\u0627\u062a",'workspace.step3.desc':"\u064a\u0642\u0648\u0645 \u0627\u0644\u0645\u0645\u0627\u0631\u0633 \u0628\u0627\u0633\u062a\u0643\u0645\u0627\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u062f\u0648\u0646 \u0627\u0644\u0625\u062e\u0644\u0627\u0644 \u0628\u0633\u062c\u0644 \u0627\u0644\u062a\u062f\u0642\u064a\u0642.",'workspace.step4.title':"4. \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0628\u0637\u0628 \u0627\u0644\u0639\u0645\u0644",'workspace.step4.desc':"\u064a\u062a\u0648\u0644\u0649 \u0637\u0628 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0633\u0631\u064a \u0648\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u0635\u0644\u064a\u0629 \u0627\u0644\u062f\u0648\u0631\u064a\u0629.",'workspace.step5.title':"5. \u062a\u0631\u0635\u062f \u0627\u0644\u062c\u0648\u062f\u0629",'workspace.step5.desc':"\u064a\u062d\u0644\u0644 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u062c\u0648\u062f\u0629 \u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0648\u0628\u0627\u0626\u064a\u0629 \u0627\u0644\u062a\u062c\u0645\u064a\u0639\u064a\u0629 \u0648\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u062e\u0637\u0631.",'workspace.step6.title':"6. \u062e\u0637\u0629 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0648\u0642\u0627\u064a\u0629",'workspace.step6.desc':"\u062a\u062d\u062f\u064a\u062f \u0648\u062a\u0646\u0641\u064a\u0630 \u0648\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u0635\u062d\u064a\u062d\u064a\u0629 \u0648\u0627\u0644\u0648\u0642\u0627\u0626\u064a\u0629 \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u0643\u0631\u0