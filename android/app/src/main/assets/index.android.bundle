ion.",'oh.detail.timelineTitle':"Follow-up event timeline",'oh.detail.unauthorizedMessage':"You are not authorized to view details of this coordination record.",'oh.event.dateInvalid':"Invalid date format. Please use YYYY-MM-DD.",'oh.event.charCount':"characters",'oh.event.noteDescription':"Administrative non-clinical tracking note only (300 characters max).",'oh.create.reasonHelp':"Select the administrative reason justifying this coordination:",'oh.create.disclaimerDetail':"This action records an internal administrative coordination request. It does not replace emergency medical care or blood exposure protocols.",'surveillance.nav.title':"Surveillance Dashboard",'surveillance.title':"AES Surveillance & Aggregate Monitoring",'surveillance.disclaimer':"SYNTHETIC DEMONSTRATION DATA \u2014 This dashboard displays aggregate prototype indicators for technical demonstration. It does not represent validated institutional or official statistics.",'surveillance.unauthorized':"Access restricted to authorized personnel (Quality Staff, Admin Reviewer, Occupational Health).",'surveillance.roleBadge':"Surveillance & Quality Staff Session (Demo)",'surveillance.filters.title':"Surveillance Filters",'surveillance.filters.all':"All",'surveillance.filters.status':"Status:",'surveillance.filters.exposure':"Exposure Type:",'surveillance.filters.startDate':"From: YYYY-MM-DD",'surveillance.filters.endDate':"To: YYYY-MM-DD",'surveillance.filters.clear':"Clear Filters",'surveillance.overview.title':"Overview Indicators",'surveillance.overview.total':"Total Declarations",'surveillance.overview.draft':"Drafts",'surveillance.overview.submitted':"Submitted",'surveillance.overview.underReview':"Under Review",'surveillance.overview.correctionRequested':"Correction Requested",'surveillance.overview.resubmitted':"Resubmitted",'surveillance.overview.closed':"Closed",'surveillance.overview.activeOh':"Active OH Coordinations",'surveillance.overview.completedOh':"Completed OH Follow-ups",'surveillance.temporal.title':"Declaration Trend Over Time",'surveillance.temporal.empty':"No temporal data for the selected criteria.",'surveillance.exposure.title':"Exposure Category Distribution",'surveillance.exposure.empty':"No exposure records found.",'surveillance.status.title':"Declaration Status Distribution",'surveillance.admin.title':"Administrative Review Indicators",'surveillance.admin.totalReviews':"Total Administrative Reviews",'surveillance.admin.correctionRequests':"Correction Requests Issued",'surveillance.admin.correctionResponses':"Correction Responses Received",'surveillance.admin.outcomes':"Administrative Outcomes",'surveillance.oh.title':"Occupational Health Indicators",'surveillance.oh.status':"Coordination Statuses",'surveillance.oh.events':"Recorded Follow-up Events by Category",'prevention.nav.title':"Prevention & CAPA",'prevention.title':"Prevention & Corrective/Preventive Actions",'prevention.disclaimer':"Demonstration prototype \u2014 Synthetic data only. Does not represent validated institutional statistics.",'prevention.provisional.disclaimer':"\u26a0 Provisional categories \u2014 institutional validation required before any official use.",'prevention.unauthorized':"Access restricted to authorised staff (Quality, Admin Reviewer, Occupational Health).",'prevention.overview.title':"Action Overview",'prevention.overview.total':"Total Actions",'prevention.overview.proposed':"Proposed",'prevention.overview.in_progress':"In Progress",'prevention.overview.completed':"Completed",'prevention.overview.cancelled':"Cancelled",'prevention.overview.viewRegister':"View Register",'prevention.overview.newAction':"New Action",'prevention.register.title':"Action Register",'prevention.register.empty':"No actions recorded for these criteria.",'prevention.register.filterStatus':"Status",'prevention.register.filterType':"Type",'prevention.register.filterFactor':"Factor",'prevention.register.clearFilters':"Clear",'prevention.register.all':"All",'prevention.register.retry':"Retry",'prevention.register.viewDetails':"View action details",'prevention.create.title':"New CAPA Action",'prevention.create.subtitle':"Formulate a corrective or preventive measure",'prevention.create.actionTitle':"Action Title *",'prevention.create.description':"Detailed Description *",'prevention.create.action_type':"Measure Type *",'prevention.create.corrective':"Corrective",'prevention.create.preventive':"Preventive",'prevention.create.factor.label':"Contributing Factor (Provisional)",'prevention.create.factor.none':"\u2014 No Factor \u2014",'prevention.create.factor.disclaimer':"\u26a0 Provisional categories \u2014 institutional validation required.",'prevention.create.rationale':"Rationale *",'prevention.create.target_date':"Target Date (optional, YYYY-MM-DD)",'prevention.create.surveillance_reference':"Surveillance Reference (optional)",'prevention.create.submit':"Save Action",'prevention.create.submitting':"Saving\u2026",'prevention.create.success':"Action saved successfully.",'prevention.create.retry':"Retry",'prevention.create.error':"The action could not be saved. Your information remains available.",'prevention.create.denied':"Only quality staff may create CAPA actions.",'prevention.create.validation.title':"The title must contain at least 3 characters.",'prevention.create.validation.description':"The description must contain at least 5 characters.",'prevention.create.validation.rationale':"The rationale must contain at least 5 characters.",'prevention.create.validation.targetDate':"The target date must use YYYY-MM-DD format.",'prevention.create.validation.surveillanceReference':"The reference must be an aggregate observation, not an individual AES reference.",'prevention.create.placeholder.title':"Example: Provision of safety sharps containers",'prevention.create.placeholder.description':"Describe the proposed measure",'prevention.create.placeholder.rationale':"Explain the rationale for the measure",'prevention.create.placeholder.surveillanceReference':"Example: Observation Q3-2026",'prevention.detail.title':"Action Detail",'prevention.detail.subtitle':"Action information and authorized lifecycle actions",'prevention.detail.notFound':"This CAPA action could not be found.",'prevention.detail.loadError':"This action could not be loaded. Please retry.",'prevention.detail.retry':"Retry",'prevention.detail.actionInformation':"Action information",'prevention.detail.recordInformation':"Record information",'prevention.detail.lifecycleActions':"Lifecycle actions",'prevention.detail.referenceCode':"Reference",'prevention.detail.status.proposed':"Proposed",'prevention.detail.status.in_progress':"In Progress",'prevention.detail.status.completed':"Completed",'prevention.detail.status.cancelled':"Cancelled",'prevention.detail.type.corrective':"Corrective",'prevention.detail.type.preventive':"Preventive",'prevention.detail.factor':"Contributing Factor",'prevention.detail.rationale':"Rationale",'prevention.detail.targetDate':"Target Date",'prevention.detail.completedAt':"Completed On",'prevention.detail.completionNotes':"Completion Note",'prevention.detail.start_action':"Start",'prevention.detail.complete_action':"Complete",'prevention.detail.cancel_action':"Cancel",'prevention.detail.completion_note_prompt':"Completion note required (min. 3 characters)",'prevention.detail.completionNoteLabel':"Completion note",'prevention.detail.cancelNoteLabel':"Cancellation note (optional)",'prevention.detail.cancelConfirmation':"Confirm cancellation of this action?",'prevention.detail.confirmCancellation':"Confirm cancellation",'prevention.detail.keepAction':"Keep action",'prevention.detail.transitionError':"The update could not be confirmed. Refresh the action state before retrying.",'prevention.detail.refreshRetry':"Refresh action state",'prevention.detail.validation.completionNote':"The completion note must contain at least 3 characters.",'prevention.detail.auditEmpty':"No audit events have been recorded.",'prevention.detail.audit_history':"Change History",'prevention.detail.createdAt':"Created On",'prevention.detail.updatedAt':"Updated On",'prevention.factor.device_safety_design':"Safe device design",'prevention.factor.procedure_compliance':"Procedure compliance",'prevention.factor.workload_fatigue':"Workload / Fatigue",'prevention.factor.waste_disposal_container':"Sharps disposal container",'prevention.factor.protective_equipment':"Personal protective equipment",'prevention.factor.training_supervision':"Training / Supervision",'prevention.factor.environment_workspace':"Environment / Workspace",'prevention.factor.other_factor':"Other factor",'prevention.factor.none':"Not specified",'workspace.tagline':"Integrated Blood Exposure Incident (AES) Management Platform",'workspace.disclaimerTitle':"PFE Demonstration Prototype \u2014 Synthetic Data Only",'workspace.disclaimerText':"This prototype is designed exclusively for graduation defense (PFE). All data displayed is synthetic and locally generated. No real patient or hospital data is processed. Roles and workflows are simulated in local memory.",'workspace.roleSelectorTitle':"Demonstration Role Selector",'workspace.roleSelectorSubtitle':"Switch between the 5 roles to view permitted workflows and access boundaries.",'workspace.roleDesc.exposed':"Immediate incident reporting, viewing personal declarations, responding to administrative correction requests.",'workspace.roleDesc.admin':"Administrative review, requesting corrections, initiating Occupational Health coordination, viewing CAPA.",'workspace.roleDesc.oh':"Occupational health management, serological follow-up (HIV/HBV/HCV), follow-up events, SST closure.",'workspace.roleDesc.quality':"De-identified epidemiological surveillance, aggregate metrics review, CAPA action plan management.",'workspace.roleDesc.tech':"System maintenance, SQLite schema verification and local integrity. Clinical and personal data strictly prohibited.",'workspace.correctionActionRequired':"Pending Correction Request",'workspace.correctionActionDesc':"The administrative reviewer has requested a correction on one of your declarations. Please provide the required information.",'workspace.permittedModulesTitle':"Permitted Modules for this Role",'workspace.module.newDeclaration':"Report an AES Incident",'workspace.module.newDeclarationDesc':"Step-by-step reporting of a blood exposure incident",'workspace.module.myDeclarations':"My Declarations",'workspace.module.myDeclarationsDesc':"History and status of your personal incident reports",'workspace.module.adminQueue':"Administrative Review Queue",'workspace.module.adminQueueDesc':"Review submitted declarations, validate or request corrections",'workspace.module.allDeclarations':"Global Declaration Register",'workspace.module.allDeclarationsDesc':"Facility-wide administrative overview of all incident declarations",'workspace.module.ohQueue':"Occupational Health Queue",'workspace.module.ohQueueDesc':"Occupational medical coordination and serological follow-up for exposed staff",'workspace.module.surveillanceDashboard':"Epidemiological Surveillance Dashboard",'workspace.module.surveillanceDashboardDesc':"De-identified aggregate metrics, trends, exposure types, and filters",'workspace.module.preventionOverview':"Prevention & CAPA Overview",'workspace.module.preventionOverviewDesc':"Summary metrics for corrective and preventive actions",'workspace.module.preventionRegister':"CAPA Action Register",'workspace.module.preventionRegisterDesc':"Operational management, status transitions, and action completion",'workspace.module.preventionRegisterReadOnly':"Prevention Register (Read-Only)",'workspace.module.preventionRegisterReadOnlyDesc':"Consultation of the action register without edit rights",'workspace.module.preventionCreate':"Create a CAPA Action",'workspace.module.preventionCreateDesc':"Formulate a corrective or preventive action following an improvement observation",'workspace.notice.exposedRestrictions':"Boundary: You cannot access declarations of other staff, the quality dashboard, or CAPA management.",'workspace.notice.qualityRestrictions':"Privacy protection: You have access to de-identified aggregate indicators and the CAPA register, but no access to identifiable declarations or SST medical records.",'workspace.notice.techRestrictions':"Strict isolation: You have access to SQLite diagnostics and technical integrity tools, but no access to clinical or personal data.",'workspace.tech.sqliteIntegrity':"Local SQLite Diagnostics",'workspace.tech.engine':'Engine','workspace.tech.schemaVersion':"Schema Version",'workspace.tech.fkCheck':"Foreign Key Check (PRAGMA foreign_key_check)",'workspace.tech.fkOk':"0 violations detected",'workspace.badgePending':"pending",'workspace.badgeActive':"active",'workspace.badgeIncidents':"AES",'workspace.badgeActions':"actions",'workspace.scenarioTitle':"Guided Demonstration Scenario (PFE)",'workspace.scenarioSubtitle':"Follow these 6 steps to present the complete AES lifecycle to the committee:",'workspace.step1.title':"1. Incident Declaration",'workspace.step1.desc':"The healthcare professional reports a blood exposure accident immediately after occurrence.",'workspace.step2.title':"2. Administrative Review",'workspace.step2.desc':"The supervisor or HR officer reviews the report and validates or requests clarification.",'workspace.step3.title':"3. Clarification / Correction",'workspace.step3.desc':"The professional provides requested clarifications without corrupting the audit trail.",'workspace.step4.title':"4. Occupational Health Follow-Up",'workspace.step4.desc':"Occupational health manages confidential follow-up and serological monitoring.",'workspace.step5.title':"5. Quality Surveillance",'workspace.step5.desc':"The quality lead analyzes de-identified epidemiological patterns and indicators.",'workspace.step6.title':"6. CAPA Action Plan",'workspace.step6.desc':"Definition, monitoring, and completion of corrective actions to prevent recurrence.",'workspace.switchRole':"Switch to this role",'workspace.activeRoleIndicator':"Active Role",'helpGlossary.title':"Help Centre & Glossary",'helpGlossary.subtitle':"Documentation, terminology, and reference guides for the demonstration",'helpGlossary.tabHelp':"Help Centre",'helpGlossary.tabGlossary':"AES Glossary",'helpGlossary.disclaimer':"This application is an academic demonstration prototype using synthetic data exclusively. It does not replace institutional protocols, professional medical advice, or official care procedures.",'helpGlossary.searchPlaceholder':"Search for a term or definition\u2026",'helpGlossary.clearSearch':"Clear search",'helpGlossary.categoryAll':"All",'helpGlossary.categoryExposure':"Exposure",'helpGlossary.categoryDeclaration':"Declaration",'helpGlossary.categoryAdmin':"Administrative",'helpGlossary.categoryOH':"Occupational Health",'helpGlossary.categoryQuality':"Quality & CAPA",'helpGlossary.emptySearch':"No terms matched your search.",'helpGlossary.backToWorkspace':"Back to Workspace",'help.section1.title':"1. Introduction to AES Guardian",'help.section1.content':"AES Guardian is an integrated demonstration prototype for reporting, administrative review, occupational-health coordination, and epidemiological surveillance of blood and body fluid exposures. Designed for an academic graduation project (PFE), it demonstrates a complete, secure workflow operating fully offline via native SQLite.",'help.section2.title':"2. Understanding the Declaration Workflow",'help.section2.content':"When a healthcare worker suffers an occupational exposure (needlestick, cut, splash), they immediately submit a digital declaration. The form records the timestamp, department, and factual circumstances without containing patient identifiers. Once submitted, the declaration can no longer be edited and enters the administrative verification queue.",'help.section3.title':"3. Understanding Administrative Review",'help.section3.content':"The HR administrator or nurse supervisor inspects incoming declarations for compliance. Three outcomes are supported: formal acknowledgment, verification of transmission to Occupational Health, or requesting clarification from the declarant. In case of correction, the declarant can submit a response without altering the original record.",'help.section4.title':"4. Understanding Occupational-Health Coordination",'help.section4.content':"The Occupational Health service ensures medical-occupational follow-up for the exposed worker. Follow-up milestones (contact attempt, consultation, serology monitoring, completion) are tracked as neutral administrative events without exposing private clinical narratives or diagnoses to the wider hospital.",'help.section5.title':"5. Understanding Epidemiological Surveillance",'help.section5.content':"The Quality Manager accesses de-identified statistical indicators: monthly incident counts, exposure type breakdowns, high-risk departments, and resolution rates. No access to individual healthcare worker identities is permitted within this view.",'help.section6.title':"6. Understanding CAPA Prevention Management",'help.section6.content':"Identified risk patterns feed into the Corrective and Preventive Action (CAPA) register. Each action targets a verified contributing factor (safety equipment, procedure compliance, waste disposal containers, training) to eliminate root causes and prevent recurrence.",'help.section7.title':"7. Understanding the 5 Synthetic Roles",'help.section7.content':"The application strictly compartmentalizes permissions: Exposed Professional (declaration and own records), Admin Reviewer (compliance and referral), OH Professional (confidential follow-up), Quality Staff (de-identified surveillance and CAPA), and Tech Admin (local database maintenance without healthcare data access).",'help.section8.title':"8. Prototype Privacy & Limitations",'help.section8.content':"This prototype runs strictly locally on-device using synthetic data. It is not a medical device, provides no diagnostic determinations, and offers no therapeutic or dosing recommendations.",'glossary.term1.term':"AES (Blood & Body Fluid Exposure)",'glossary.term1.category':"Exposure",'glossary.term1.definition':"Any accidental contact with blood or biological fluids contaminated with blood, occurring via percutaneous injury (needlestick, cut) or projection onto a mucous membrane or broken skin.",'glossary.term2.term':"Percutaneous Exposure",'glossary.term2.category':"Exposure",'glossary.term2.definition':"Penetrating skin injury caused by a hollow-bore needle, trocar, scalpel blade, or any soiled sharp instrument.",'glossary.term3.term':"Mucocutaneous Exposure",'glossary.term3.category':"Exposure",'glossary.term3.definition':"Accidental splashing or contact of blood or bodily fluid onto mucous membranes, primarily ocular (eyes) or oral (mouth).",'glossary.term4.term':"Broken Skin Exposure",'glossary.term4.category':"Exposure",'glossary.term4.definition':"Skin area with pre-existing cuts, abrasion, dermatitis, or open wounds coming into contact with potentially contaminated biological fluid.",'glossary.term5.term':"Declaration",'glossary.term5.category':"Declaration",'glossary.term5.definition':"Initial digital record of the exposure submitted by the exposed professional, recording factual circumstances without disclosing patient personal data.",'glossary.term6.term':"Administrative Review",'glossary.term6.category':"Administrative",'glossary.term6.definition':"Compliance evaluation conducted by an HR administrator or supervisor to validate the declaration and initiate necessary operational follow-up.",'glossary.term7.term':"Occupational-Health Coordination",'glossary.term7.category':"Occupational Health",'glossary.term7.definition':"Confidential process ensuring regulatory and preventive follow-up of the exposed healthcare professional by occupational-health physicians.",'glossary.term8.term':"Serology Monitoring",'glossary.term8.category':"Occupational Health",'glossary.term8.definition':"Biological laboratory tests (notably HIV, HBV, HCV) used in occupational-health follow-up monitoring after a blood or body-fluid exposure. This application records the administrative milestones of such monitoring; it does not schedule or prescribe tests.",'glossary.term9.term':"Epidemiological Surveillance",'glossary.term9.category':"Quality & CAPA",'glossary.term9.definition':"Systematic, aggregated analysis of reported incidents to detect risk trends and guide organizational prevention policies.",'glossary.term10.term':"De-identification",'glossary.term10.category':"Quality & CAPA",'glossary.term10.definition':"Privacy safeguard ensuring that statistical reports decouple incident metrics from any direct or indirect worker identifying data.",'glossary.term11.term':"Contributing Factor",'glossary.term11.category':"Quality & CAPA",'glossary.term11.definition':"Organizational, procedural, equipment-related, or environmental condition that facilitated the occurrence or worsened the severity of an incident.",'glossary.term12.term':"CAPA (Corrective & Preventive Actions)",'glossary.term12.category':"Quality & CAPA",'glossary.term12.definition':"Quality management process aimed at eliminating root causes of systemic hazards to prevent incident recurrence.",'glossary.term13.term':"Follow-Up Event",'glossary.term13.category':"Occupational Health",'glossary.term13.definition':"Timestamped, neutral milestone tracking an occupational health coordination step without exposing private medical details.",'glossary.term14.term':"Audit Log",'glossary.term14.category':"Administrative",'glossary.term14.definition':"Chronological local record of system operations maintained during the prototype demonstration. Note: this record can be cleared by a demonstration data reset.",'profile.title':"Demonstrator Profile & Settings",'profile.subtitle':"Manage active synthetic account, system preferences, and local maintenance",'profile.accountSection':"Active Demonstration Account",'profile.roleSection':"Switch Synthetic Demonstration Role",'profile.permissionsSection':"Permissions & Access Boundaries",'profile.authorizedCapabilities':"Authorized Capabilities",'profile.restrictedCapabilities':"Strictly Prohibited Actions",'profile.demoAccountNotice':"In-memory synthetic demonstration account. No persistent session or credentials required.",'profile.languageSection':"Application Language",'profile.languageSelectorTitle':"Select runtime language:",'profile.rtlNotice':"Note: Complete right-to-left (RTL) mirror layout for Arabic will be finalized in an upcoming release.",'profile.navigationSection':"Documentation & Resources",'profile.helpCenterLink':"Help Centre & Guided Workflow",'profile.glossaryLink':"AES Terminology Glossary",'profile.guidedTourLink':"Guided tour and introduction",'profile.privacySection':"Privacy & Ethical Boundaries",'profile.privacyContent':"This prototype operates strictly with local synthetic data. No real personal or clinical information is stored. Surveillance data presented to Quality staff is de-identified by design.",'profile.aboutSection':"About the Prototype",'profile.appNameLabel':"Application: AES Guardian (Sanad Module)",'profile.dbEngineLabel':"Database: SQLite (@op-engineering/op-sqlite)",'profile.maintenanceSection':"Technical Maintenance (tech_admin)",'profile.error.techAdminOnly':"Only the technical administrator can perform this operation.",'profile.error.userIdMissing':"Cannot reset without an active account context.",'profile.cap.declare':"Submit new AES declarations and manage drafts",'profile.cap.myDeclarations':"View status and history of own declarations",'profile.cap.respondCorrection':"Respond to administrative clarification requests",'profile.cap.adminReview':"Process administrative queue and record review decisions",'profile.cap.initiateOH':"Initiate referral coordination to Occupational Health",'profile.cap.ohCoordination':"Acknowledge and manage OH coordination cases",'profile.cap.ohFollowUp':"Record serology monitoring milestones and close cases",'profile.cap.surveillanceDashboard':"Consult de-identified aggregate surveillance metrics",'profile.cap.preventionRegister':"Consult the CAPA prevention register in read-only mode",'profile.cap.manageCapa':"Create, track, and close corrective and preventive actions",'profile.cap.techMaintenance':"Verify SQLite schema integrity and reset demonstration dataset",'profile.restr.noSurveillance':"Access to epidemiological surveillance dashboard denied",'profile.restr.noCapa':"Creating or managing CAPA actions not permitted",'profile.restr.noOtherDeclarations':"Viewing declarations filed by other workers strictly prohibited",'profile.restr.noClinicalContent':"Access to clinical notes or personal health records strictly prohibited",'profile.restr.noAdminQueue':"Access to administrative review queue denied",'profile.restr.noIdentifiableData':"Access to identifiable healthcare worker identities refused",'reset.sectionTitle':"Synthetic Demonstration Data Reset",'reset.sectionDesc':"Maintenance action reserved exclusively for tech_admin. Clears user modifications and restores the pristine baseline demonstration dataset.",'reset.buttonLabel':"Reset Demonstration Data",'reset.dialog1Title':"Reset Demonstration Data?",'reset.dialog1Message':"This operation will erase all added declarations, reviews, follow-up events, and CAPA actions to restore the pristine baseline scenario (4 declarations, 5 CAPAs). This action cannot be undone.",'reset.dialog1Cancel':"Cancel",'reset.dialog1Continue':"Continue\u2026",'reset.dialog2Title':"Final Confirmation",'reset.dialog2Message':"Are you absolutely sure you want to reset the local demonstration database now?",'reset.dialog2Cancel':"Cancel",'reset.dialog2Confirm':"Confirm Reset",'reset.inProgress':"Resetting demonstration database\u2026",'reset.successTitle':"Reset Completed",'reset.successMessage':"The demonstration scenario has been restored.",'reset.errorTitle':"Reset Failed",'reset.errorMessage':"An error occurred during atomic reset execution:",'notification.declarationSubmitted.title':"New Declaration Submitted",'notification.declarationSubmitted.message':"Declaration {reference} has been registered and is pending administrative review.",'notification.reviewCompleted.title':"Administrative Review Completed",'notification.reviewCompleted.message':"The administrative review for your declaration {reference} has been completed.",'notification.correctionRequested.title':"Correction Requested",'notification.correctionRequested.message':"Clarifications are required for your declaration {reference}.",'notification.correctionSubmitted.title':"Correction Response Submitted",'notification.correctionSubmitted.message':"The declarant has submitted corrections for declaration {reference}.",'notification.ohCoordinationCreated.title':"New Occupational Health Case",'notification.ohCoordinationCreated.message':"A new occupational health coordination case has been opened for declaration {reference}.",'notification.ohCoordinationAcknowledged.title':"Occupational Health Case Acknowledged",'notification.ohCoordinationAcknowledged.message':"The occupational health service has acknowledged your case {reference}.",'notification.ohMilestoneRecorded.title':"Follow-Up Milestone Recorded",'notification.ohMilestoneRecorded.message':"A follow-up milestone has been recorded for your case {reference}.",'notification.ohCoordinationCompleted.title':"Occupational Health Case Closed",'notification.ohCoordinationCompleted.message':"The occupational health follow-up for your declaration {reference} is now closed.",'notification.capaCreated.title':"Prevention Action Created",'notification.capaCreated.message':"Prevention action {reference} has been registered in the CAPA register.",'notification.capaStatusChanged.title':"CAPA Status Updated",'notification.capaStatusChanged.message':"The status of prevention action {reference} has been updated.",'notification.capaFinalized.title':"Prevention Action Finalized",'notification.capaFinalized.message':"Prevention action {reference} has been finalized in the CAPA register.",'notificationCentre.title':"Notification Centre",'notificationCentre.empty':"No notifications",'notificationCentre.emptySubtitle':"You have no notifications at this time.",'notificationCentre.markAllRead':"Mark all as read",'notificationCentre.markAllReadConfirm':"Mark all notifications as read?",'notificationCentre.confirm':"Confirm",'notificationCentre.cancel':"Cancel",'notificationCentre.retry':"Retry",'notificationCentre.unread':"Unread",'notificationCentre.read':"Read",'notificationCentre.today':"Today",'notificationCentre.yesterday':"Yesterday",'notificationCentre.tapToOpen':"Tap to open",'notificationCentre.errorLoad':"Unable to load notifications.",'notificationCentre.errorNavigation':"Destination not found or access denied.",'notificationCentre.errorStale':"This notification may be outdated or you no longer have access.",'notificationCentre.techAdminRestricted':"Technical administrators do not have access to operational notifications.",'notificationCentre.a11y.unreadBadge':"Unread notifications",'notificationCentre.a11y.notificationItem':"Notification",'notificationCentre.a11y.markAllRead':"Mark all notifications as read",'splash.wordmark':'AES Guardian','splash.subtitle':'Hospital Blood Exposure Governance','splash.enter':'Enter Workspace','onboarding.lang.overline':'SYSTEM LANGUAGE','onboarding.lang.title':'Choose your language','onboarding.lang.subtitle':'Select the display language for the hospital demonstration prototype.','onboarding.continue':'Continue','onboarding.carousel.skip':'Skip','onboarding.carousel.start':'Get Started','onboarding.carousel.next':'Next','onboarding.carousel.slide1.title':'Fast & Protected Declaration','onboarding.carousel.slide1.desc':'Structured 5-step incident declaration workflow immediately upon exposure, with local draft saving.','onboarding.carousel.slide1.bullet1':'Local draft preservation','onboarding.carousel.slide1.bullet2':'Structured 5-step guided form','onboarding.carousel.slide1.bullet3':'Guided resumption of in-progress drafts','onboarding.carousel.slide2.title':'Confidential OH Coordination','onboarding.carousel.slide2.desc':'Occupational health coordination tracking with role-based data minimization and protected medical notes.','onboarding.carousel.slide2.bullet1':'Follow-up notes reserved for occupational health','onboarding.carousel.slide2.bullet2':'Tracking of post-exposure coordination milestones','onboarding.carousel.slide2.bullet3':'Restricted status projection for the exposed professional','onboarding.carousel.slide3.title':'Surveillance & Prevention','onboarding.carousel.slide3.desc':'Aggregated statistical metrics without personal identifiers and local register of corrective and preventive actions (CAPA).','onboarding.carousel.slide3.bullet1':'Aggregated metrics without personal identifiers','onboarding.carousel.slide3.bullet2':'Structured register of preventive actions (CAPA)','onboarding.carousel.slide3.bullet3':'Strict role-based access partitioning','onboarding.disclaimer.title':'Warning \u2014 Demonstration Prototype','onboarding.disclaimer.badge':'ACADEMIC PFE PROTOCOL','onboarding.disclaimer.p1':'1. This software is an academic graduation project (PFE) prototype. All data, incidents, personnel, and IDs are 100% synthetic.','onboarding.disclaimer.p2':'2. No real medical data is stored or transmitted. The system operates strictly offline on a local SQLite database.','onboarding.disclaimer.p3':'3. This application is not a certified medical device and does not perform autonomous clinical triage or drug prescription.','onboarding.disclaimer.p4':'4. This prototype does not replace emergency medical care. In case of actual exposure, immediately follow your institution\'s emergency protocol and consult emergency medical services without delay.','onboarding.disclaimer.checkbox':'I understand the academic nature of the prototype and the synthetic nature of the data.','onboarding.disclaimer.accept':'Accept and Continue','onboarding.picker.title':'Demonstration Accounts','onboarding.picker.subtitle':'Select one of the 5 canonical roles to explore operational workflows and authorization boundaries.','onboarding.picker.syntheticNotice':'Local synthetic accounts with no password. Identifiers (e.g. NURSE-001) are demonstration codes for evaluators.','onboarding.picker.enter':'Enter Workspace','onboarding.picker.role1.code':'NURSE-001','onboarding.picker.role1.title':'Exposed Healthcare Professional','onboarding.picker.role1.desc':'AES incident declaration and tracking of own records.','onboarding.picker.role2.code':'ADMIN-001','onboarding.picker.role2.title':'Nurse Supervisor / Nursing Directorate','onboarding.picker.role2.desc':'Administrative review, correction requests, and validation.','onboarding.picker.role3.code':'OCC-001','onboarding.picker.role3.title':'Occupational Health (OH)','onboarding.picker.role3.desc':'Clinical follow-up and administrative management of post-exposure coordination.','onboarding.picker.role4.code':'QUAL-001','onboarding.picker.role4.title':'Quality & Risk Management','onboarding.picker.role4.desc':'Aggregated epidemiological surveillance and CAPA corrective actions.','onboarding.picker.role5.code':'ADMIN-TECH','onboarding.picker.role5.title':'Technical Administrator','onboarding.picker.role5.desc':'Prototype diagnostics and synthetic demonstration data reset.','list.filter.all':'All','list.filter.draft':'Drafts','list.filter.submitted':'Submitted','list.filter.under_review':'Under Review','list.filter.closed':'Closed','list.adminQueueShortcut':'Review Queue','list.restrictedTitle':'Restricted Access','list.restrictedMessage':'Your role does not permit access to the declaration list.','list.incidentType':'Exposure Type','list.title.admin':'All Declarations','details.tab.summary':'Summary','details.tab.incident':'Incident','details.tab.measures':'Measures','details.tab.status':'Status','details.tab.followup':'Follow-up','details.followup.noCoordination':'No occupational health follow-up recorded.','details.followup.coordinationStatus':'Follow-up Status','details.followup.coordinationDate':'Initiated','details.followup.updatedAt':'Updated','details.followup.adminSummary':'Coordination Summary (Administrative)','details.followup.reason':'Coordination Reason','details.followup.acknowledgedAt':'Acknowledged','details.followup.completedAt':'Completed','details.restrictedAccess':'Unauthorized Access','details.notFound':'Declaration not found.','details.reviewHistory':'Review History','details.reviewAction':'Review Declaration','details.createCoordination':'Initiate OH Follow-up','details.respondToCorrection':'Respond to Correction Request','details.correctionPending':'A correction has been requested for this declaration.'},ar:{'navigation.back':'\u0631\u062c\u0648\u0639','workspace.nav.title':'\u0645\u0633\u0627\u062d\u0629 AES Guardian','prevention.create.acknowledgement.confirm':'\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0639\u0631\u0636','prevention.create.acknowledgement.inProgress':'\u062c\u0627\u0631\u064a \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0639\u0631\u0636...','prevention.create.acknowledgement.error':'\u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0639\u0631\u0636','prevention.create.result.title':'\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0648\u0642\u0627\u064a\u0629','prevention.create.result.recovery':'\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0646\u0634\u0623','prevention.create.uncertain':'\u0625\u0646\u0634\u0627\u0621 \u063a\u064a\u0631 \u0645\u0624\u0643\u062f - \u0627\u0644\u062d\u0627\u0644\u0629 \u0645\u0639\u0644\u0642\u0629','prevention.create.reconcileAbsent':'\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629','prevention.create.reference':'\u0627\u0644\u0645\u0631\u062c\u0639','prevention.create.reconcile':'\u0645\u0637\u0627\u0628\u0642\u0629','surveillance.filters.declarationCountLabel':'\u0639\u062f\u062f \u0627\u0644\u062a\u0635\u0631\u064a\u062d\u0627\u062a','surveillance.status.empty':'\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0631\u0627\u0642\u0628\u0629 \u0645\u062a\u0627\u062d\u0629','app.name':'\u062d\u0627\u0631\u0633 AES','app.loading':'\u2026\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0645\u064a\u0644','app.back':'\u0631\u062c\u0648\u0639','app.ok':'\u062d\u0633\u0646\u064b\u0627','app.offline':'\u063a\u064a\u0631 \u0645\u062a\u0635\u0644 \u2014 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0645\u062a\u0627\u062d\u0629','db.initializing':'\u2026\u062c\u0627\u0631\u064d \u062a\u0647\u064a\u0626\u0629 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a','db.ready':'\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062c\u0627\u0647\u0632\u0629','db.error':'\u062e\u0637\u0623 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a','nav.declarations':'\u062a\u0635\u0631\u064a\u062d\u0627\u062a AES','nav.newDeclaration':'\u062a\u0635\u0631\u064a\u062d \u062c\u062f\u064a\u062f','nav.declarationDetails':'\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062a\u0635\u0631\u064a\u062d','nav.back':'\u0631\u062c\u0648\u0639','list.title':'\u062a\u0635\u0631\u064a\u062d\u0627\u062a\u064a','list.empty':'\u0644\u0627 \u062a\u0648\u062c\u062f \u062a\u0635\u0631\u064a\u062d\u0627\u062a','list.emptySubtitle':'\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0632\u0631 \u0623\u062f\u0646\u0627\u0647 \u0644\u0625\u0646\u0634\u0627\u0621 \u0623\u0648\u0644 \u062a\u0635\u0631\u064a\u062d.','list.newButton':'\u062a\u0635\u0631\u064a\u062d \u062c\u062f\u064a\u062f','list.refNumber':'\u0627\u0644\u0645\u0631\u062c\u0639','list.refUnavailable':'\u0627\u0644\u0645\u0631\u062c\u0639 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d','list.incidentDate':'\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0627\u062f\u062b\u0629','list.status':'\u0627\u0644\u062d\u0627\u0644\u0629','form.title.new':'\u062a\u0635\u0631\u064a\u062d AES \u062c\u062f\u064a\u062f','form.title.edit':'\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0633\u0648\u062f\u0629','form.unauthorized':'\u0647\u0630\u0647 \u0627\u0644\u0634\u0627\u0634\u0629 \u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u0645\u0645\u0627\u0631\u0633 \u0627\u0644\u0630\u064a \u0623\u0628\u0644\u063a \u0639\u0646 \u0627\u0644\u062d\u0627\u062f\u062b.','form.incidentDate':'\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0627\u0644\u062d\u0627\u062f\u062b\u0629','form.incidentDate.placeholder':'\u064a\u064a/\u0634\u0634/\u0633\u0633\u0633\u0633','form.incidentType':'\u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u0631\u0636','form.incidentType.placeholder':'\u0627\u062e\u062a\u0631 \u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u0631\u0636','form.incidentType.percutaneous':'\u062d\u0627\u062f\u062b \u062c\u0644\u062f\u064a (\u0648\u062e\u0632 \u0625\u0628\u0631\u0629 / \u062c\u0631\u062d)','form.incidentType.percutaneous.desc':'\u0648\u062e\u0632 \u0625\u0628\u0631\u0629\u060c \u0623\u0648 \u062c\u0631\u062d \u0628\u0645\u0634\u0631\u0637\u060c \u0623\u0648 \u0627\u062e\u062a\u0631\u0627\u0642 \u062c\u0644\u062f\u064a \u0645\u0644\u0648\u062b','form.incidentType.mucocutaneous':'\u062a\u0646\u0627\u062b\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u063a\u0634\u064a\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u064a\u0629 \u0623\u0648 \u0627\u0644\u062c\u0644\u062f','form.incidentType.mucocutaneous.desc':'\u062a\u0646\u0627\u062b\u0631 \u0633\u0648\u0627\u0626\u0644 \u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u063a\u0634\u064a\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u064a\u0629 (\u0627\u0644\u0639\u064a\u0646\u060c \u0627\u0644\u0641\u0645) \u0623\u0648 \u0627\u0644\u062c\u0644\u062f \u0627\u0644\u0645\u0635\u0627\u0628','form.incidentType.sexual_assault':'\u0627\u0639\u062a\u062f\u0627\u0621 \u062c\u0646\u0633\u064a','form.incidentType.sexual_assault.desc':'\u062d\u0627\u0644\u0629 \u062a\u0639\u0631\u0636 \u062e\u0627\u0635\u0629 \u062a\u062a\u0637\u0644\u0628 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0637\u0648\u0627\u0631\u0626 \u0645\u062e\u0635\u0635','form.incidentType.other':'\u0623\u062e\u0631\u0649 (\u064a\u0631\u062c\u0649 \u0627\u0644\u0648\u0635\u0641 \u0641\u064a \u062e\u0627\u0646\u0629 \u0627\u0644\u0645\u0644\u0627\u0628\u0633\u0627\u062a)','form.incidentType.other.desc':'\u062d\u0627\u0644\u0629 \u0623\u062e\u0631\u0649 \u0645\u0646 \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0647\u0646\u064a \u0627\u0644\u0639\u0631\u0636\u064a \u0644\u0644\u062f\u0645','form.circumstances':'\u0645\u0644\u0627\u0628\u0633\u0627\u062a \u0627\u0644\u062d\u0627\u062f\u062b\u0629','form.circumstances.placeholder':'\u2026\u0635\u0641 \u0645\u0644\u0627\u0628\u0633\u0627\u062a \u0627\u0644\u062d\u0627\u062f\u062b\u0629','form.exposureDescription':'\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u062a\u0639\u0631\u0636','form.exposureDescription.placeholder':'\u2026\u0635\u0641 \u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u062a\u0639\u0631\u0636','form.protectiveMeasures':'\u0627\u0644\u062a\u062f\u0627\u0628\u064a\u0631 \u0627\u0644\u0648\u0642\u0627\u0626\u064a\u0629 \u0627\u0644\u0645\u062a\u062e\u0630\u0629','form.protectiveMeasures.placeholder':'\u2026\u0623\u0634\u0631 \u0625\u0644\u0649 \u0627\u0644\u062a\u062f\u0627\u0628\u064a\u0631 \u0627\u0644\u0645\u062a\u062e\u0630\u0629','form.departmentCode':'\u0627\u0644\u0642\u0633\u0645 / \u0627\u0644\u0648\u062d\u062f\u0629','form.departmentCode.placeholder':'\u0631\u0645\u0632 \u0627\u0644\u0642\u0633\u0645 \u0623\u0648 \u0627\u0633\u0645\u0647 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)','form.notes':'\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629','form.notes.placeholder':'\u2026\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629','form.required':'\u0645\u0637\u0644\u0648\u0628','form.optional':'\u0627\u062e\u062a\u064a\u0627\u0631\u064a','form.saveDraft':'\u062d\u0641\u0638 \u0627\u0644\u0645\u0633\u0648\u062f\u0629','form.submit':'\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062a\u0635\u0631\u064a\u062d','form.saving':'\u2026\u062c\u0627\u0631\u064d \u0627\u0644\u062d\u0641\u0638','form.submitting':'\u2026\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u0642\u062f\u064a\u0645','form.savedDraft':'\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0645\u0633\u0648\u062f\u0629','form.disclaimer':'\u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0631\u064a\u062d \u0645\u062e\u0635\u0635 \u0644\u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0641\u0642\u0637. \u0644\u0627 \u064a\u0645\u062b\u0644 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0637\u0628\u064a\u0629.','form.step.counter':'\u0627\u0644\u062e\u0637\u0648\u0629 {step} \u0645\u0646 5','form.step1.title':'\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0627\u0645\u0629','form.step1.subtitle':'\u062a\u0627\u0631\u064a\u062e \u0648\u0645\u0643\u0627\u0646 \u0648\u0642\u0648\u0639 \u062d\u0627\u062f\u062b \u0627\u0644\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0647\u0646\u064a \u0644\u0644\u062f\u0645.','form.step2.title':'\u062e\u0635\u0627\u0626\u0635 \u0627\u0644\u062a\u0639\u0631\u0636','form.step2.subtitle':'\u062d\u062f\u062f \u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0647\u0646\u064a \u0627\u0644\u0630\u064a \u062d\u062f\u062b.','form.step3.title':'\u0645\u0644\u0627\u0628\u063