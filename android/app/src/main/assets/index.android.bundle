\u062b",'helpGlossary.categoryAll':"\u0627\u0644\u0643\u0644",'helpGlossary.categoryExposure':"\u0627\u0644\u062a\u0639\u0631\u0636",'helpGlossary.categoryDeclaration':"\u0627\u0644\u0625\u0628\u0644\u0627\u063a",'helpGlossary.categoryAdmin':"\u0625\u062f\u0627\u0631\u064a",'helpGlossary.categoryOH':"\u0637\u0628 \u0627\u0644\u0639\u0645\u0644",'helpGlossary.categoryQuality':"\u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0627\u0644\u0648\u0642\u0627\u064a\u0629",'helpGlossary.emptySearch':"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0635\u0637\u0644\u062d\u0627\u062a \u062a\u0637\u0627\u0628\u0642 \u0628\u062d\u062b\u0643.",'helpGlossary.backToWorkspace':"\u0627\u0644\u0639\u0648\u062f\u0629 \u0644\u0644\u0645\u0633\u0627\u062d\u0629",'help.section1.title':"1. \u0645\u0642\u062f\u0645\u0629 \u062d\u0648\u0644 \u0646\u0638\u0627\u0645 AES Guardian",'help.section1.content':"\u0646\u0638\u0627\u0645 AES Guardian \u0646\u0645\u0648\u0630\u062c \u062a\u062c\u0631\u064a\u0628\u064a \u0645\u062a\u0643\u0627\u0645\u0644 \u0644\u0644\u0625\u0628\u0644\u0627\u063a \u0648\u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0645\u0639 \u0637\u0628 \u0627\u0644\u0639\u0645\u0644 \u0648\u0627\u0644\u062a\u0631\u0635\u062f \u0627\u0644\u0648\u0628\u0627\u0626\u064a \u0644\u062d\u0648\u0627\u062f\u062b \u0627\u0644\u062a\u0639\u0631\u0636 \u0644\u0644\u062f\u0645 \u0641\u064a \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u064a\u0627\u062a. \u0635\u064f\u0645\u0645 \u0636\u0645\u0646 \u0645\u0634\u0631\u0648\u0639 \u062a\u062e\u0631\u062c \u0623\u0643\u0627\u062f\u064a\u0645\u064a (PFE)\u060c \u0648\u064a\u0639\u0631\u0636 \u0645\u0633\u0627\u0631 \u0639\u0645\u0644 \u0645\u0633\u062a\u0645\u0631 \u0648\u0622\u0645\u0646 \u064a\u0639\u0645\u0644 \u0645\u062d\u0644\u064a\u0627\u064b \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0639\u0628\u0631 SQLite.",'help.section2.title':"2. \u0641\u0647\u0645 \u0645\u0633\u0627\u0631 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0627\u0644\u062d\u0627\u062f\u062b",'help.section2.content':"\u0639\u0646\u062f \u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0645\u0627\u0631\u0633 \u0627\u0644\u0635\u062d\u064a \u0644\u062d\u0627\u062f\u062b (\u0648\u062e\u0632 \u0625\u0628\u0631\u0629\u060c \u062c\u0631\u062d\u060c \u062a\u0646\u0627\u062b\u0631 \u0633\u0648\u0627\u0626\u0644 \u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629)\u060c \u064a\u0642\u0648\u0645 \u0641\u0648\u0631\u0627\u064b \u0628\u062a\u0633\u062c\u064a\u0644 \u0628\u0644\u0627\u063a \u0631\u0642\u0645\u064a \u064a\u0648\u062b\u0642 \u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0648\u0627\u0644\u0642\u0633\u0645 \u0648\u0627\u0644\u0638\u0631\u0648\u0641 \u0627\u0644\u0645\u0648\u0636\u0648\u0639\u064a\u0629 \u062f\u0648\u0646 \u0625\u062f\u0631\u0627\u062c \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0639\u0631\u064a\u0641\u064a\u0629 \u0644\u0644\u0645\u0631\u0636\u0649. \u0648\u0628\u0639\u062f \u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u064a\u0635\u0628\u062d \u0627\u0644\u0628\u0644\u0627\u063a \u063a\u064a\u0631 \u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0639\u062f\u064a\u0644 \u0648\u064a\u062f\u062e\u0644 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0641\u062d\u0635.",'help.section3.title':"3. \u0641\u0647\u0645 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629",'help.section3.content':"\u064a\u0642\u0648\u0645 \u0627\u0644\u0645\u0634\u0631\u0641 \u0623\u0648 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0628\u0641\u062d\u0635 \u0627\u0644\u0628\u0644\u0627\u063a \u0625\u062f\u0627\u0631\u064a\u0627\u064b\u060c \u0648\u0644\u062f\u064a\u0647 3 \u062e\u064a\u0627\u0631\u0627\u062a: \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0631\u0633\u0645\u064a\u0627\u064b\u060c \u0623\u0648 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0644\u0637\u0628 \u0627\u0644\u0639\u0645\u0644\u060c \u0623\u0648 \u0637\u0644\u0628 \u0627\u0633\u062a\u064a\u0636\u0627\u062d\u0627\u062a \u0648\u062a\u0635\u062d\u064a\u062d\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u0645\u0627\u0631\u0633 \u062f\u0648\u0646 \u0627\u0644\u0645\u0633\u0627\u0633 \u0628\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u0623\u0648\u0644\u064a.",'help.section4.title':"4. \u0641\u0647\u0645 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0645\u0639 \u0637\u0628 \u0627\u0644\u0639\u0645\u0644",'help.section4.content':"\u064a\u062a\u0648\u0644\u0649 \u0641\u0631\u064a\u0642 \u0637\u0628 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u0647\u0646\u064a\u0629 \u0648\u0627\u0644\u0635\u062d\u064a\u0629 \u0644\u0644\u0645\u0645\u0627\u0631\u0633 \u0627\u0644\u0645\u0639\u0631\u0636. \u0648\u062a\u064f\u0633\u062c\u0644 \u0645\u062d\u0637\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 (\u0627\u0644\u062a\u0648\u0627\u0635\u0644\u060c \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0629\u060c \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u0635\u0644\u064a\u0629\u060c \u0627\u0644\u0625\u063a\u0644\u0627\u0642) \u0643\u0623\u062d\u062f\u0627\u062b \u0625\u062f\u0627\u0631\u064a\u0629 \u0645\u062d\u0627\u064a\u062f\u0629 \u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0633\u0631\u064a\u0629 \u0627\u0644\u0637\u0628\u064a\u0629 \u0627\u0644\u062a\u0627\u0645\u0629.",'help.section5.title':"5. \u0641\u0647\u0645 \u0627\u0644\u062a\u0631\u0635\u062f \u0627\u0644\u0648\u0628\u0627\u0626\u064a",'help.section5.content':"\u064a\u0637\u0644\u0639 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u062c\u0648\u062f\u0629 \u0639\u0644\u0649 \u0645\u0624\u0634\u0631\u0627\u062a \u0625\u062d\u0635\u0627\u0626\u064a\u0629 \u0645\u062c\u0645\u0639\u0629 \u0645\u062c\u0631\u062f\u0629 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629: \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u062d\u0648\u0627\u062f\u062b \u0627\u0644\u0634\u0647\u0631\u064a\u0629\u060c \u062a\u0648\u0632\u064a\u0639 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u062a\u0639\u0631\u0636\u060c \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0627\u0644\u0623\u0643\u062b\u0631 \u062a\u0639\u0631\u0636\u0627\u064b\u060c \u0648\u0646\u0633\u0628 \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0645\u0644\u0641\u0627\u062a\u060c \u062f\u0648\u0646 \u0623\u064a \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0644\u0644\u0648\u0635\u0648\u0644 \u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u0646.",'help.section6.title':"6. \u0641\u0647\u0645 \u062e\u0637\u0629 \u0627\u0644\u0648\u0642\u0627\u064a\u0629 \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u0635\u062d\u064a\u062d\u064a\u0629 (CAPA)",'help.section6.content':"\u062a\u063a\u0630\u064a \u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u062a\u0631\u0635\u062f \u0633\u062c\u0644 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u0635\u062d\u064a\u062d\u064a\u0629 \u0648\u0627\u0644\u0648\u0642\u0627\u0626\u064a\u0629. \u064a\u0633\u062a\u0647\u062f\u0641 \u0643\u0644 \u0625\u062c\u0631\u0627\u0621 \u0639\u0627\u0645\u0644\u0627\u064b \u0645\u0633\u0627\u0647\u0645\u0627\u064b \u0645\u062d\u062f\u062f\u0627\u064b (\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0623\u062f\u0648\u0627\u062a\u060c \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644\u0627\u062a\u060c \u062d\u0627\u0648\u064a\u0627\u062a \u0627\u0644\u0646\u0641\u0627\u064a\u0627\u062a \u0627\u0644\u062d\u0627\u062f\u0629\u060c \u0627\u0644\u062a\u062f\u0631\u064a\u0628) \u0644\u0644\u0642\u0636\u0627\u0621 \u0639\u0644\u0649 \u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u062e\u0637\u0631 \u0648\u0645\u0646\u0639 \u0627\u0644\u062a\u0643\u0631\u0627\u0631.",'help.section7.title':"7. \u0641\u0647\u0645 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u062a\u0631\u0643\u064a\u0628\u064a\u0629 \u0627\u0644\u062e\u0645\u0633\u0629",'help.section7.content':"\u064a\u0637\u0628\u0642 \u0627\u0644\u0646\u0638\u0627\u0645 \u0641\u0635\u0644\u0627\u064b \u0635\u0627\u0631\u0645\u0627\u064b \u0644\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a: \u0627\u0644\u0645\u0645\u0627\u0631\u0633 \u0627\u0644\u0645\u0639\u0631\u0636 (\u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0648\u0645\u0644\u0641\u0627\u062a\u0647 \u0641\u0642\u0637)\u060c \u0627\u0644\u0645\u0634\u0631\u0641 \u0627\u0644\u0625\u062f\u0627\u0631\u064a (\u0627\u0644\u0641\u062d\u0635 \u0648\u0627\u0644\u062a\u0648\u062c\u064a\u0647)\u060c \u0637\u0628 \u0627\u0644\u0639\u0645\u0644 (\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0633\u0631\u064a\u0629)\u060c \u0627\u0644\u062c\u0648\u062f\u0629 (\u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0648\u0627\u0644\u0648\u0642\u0627\u064a\u0629)\u060c \u0648\u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u062a\u0642\u0646\u064a (\u0635\u064a\u0627\u0646\u0629 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u062f\u0648\u0646 \u0623\u064a \u0648\u0635\u0648\u0644 \u0633\u0631\u064a\u0631\u064a).",'help.section8.title':"8. \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0648\u062d\u062f\u0648\u062f \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a",'help.section8.content':"\u064a\u0639\u0645\u0644 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0645\u062d\u0644\u064a\u0627\u064b \u0648\u0628\u0634\u0643\u0644 \u0645\u0639\u0632\u0648\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0631\u0643\u064a\u0628\u064a\u0629. \u0648\u0644\u0627 \u064a\u064f\u0639\u062f \u062c\u0647\u0627\u0632\u0627\u064b \u0637\u0628\u064a\u0627\u064b \u0648\u0644\u0627 \u064a\u0642\u062f\u0645 \u062a\u0634\u062e\u064a\u0635\u0627\u062a \u0623\u0648 \u0648\u0635\u0641\u0627\u062a \u0639\u0644\u0627\u062c\u064a\u0629 \u0623\u0648 \u062c\u0631\u0639\u0627\u062a \u062f\u0648\u0627\u0626\u064a\u0629.",'glossary.term1.term':"AES (\u062d\u0627\u062f\u062b \u0627\u0644\u062a\u0639\u0631\u0636 \u0644\u0644\u062f\u0645)",'glossary.term1.category':"\u0627\u0644\u062a\u0639\u0631\u0636",'glossary.term1.definition':"\u0623\u064a \u062a\u0644\u0627\u0645\u0633 \u0639\u0631\u0636\u064a \u0645\u0639 \u062f\u0645 \u0623\u0648 \u0633\u0627\u0626\u0644 \u0628\u064a\u0648\u0644\u0648\u062c\u064a \u0645\u0644\u0648\u062b \u0628\u0627\u0644\u062f\u0645\u060c \u0646\u0627\u062a\u062c \u0639\u0646 \u0648\u062e\u0632 \u0625\u0628\u0631\u0629 \u0623\u0648 \u062c\u0631\u062d \u0623\u0648 \u062a\u0646\u0627\u062b\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u063a\u0634\u064a\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u064a\u0629 \u0623\u0648 \u0627\u0644\u062c\u0644\u062f \u0627\u0644\u0645\u0635\u0627\u0628.",'glossary.term2.term':"\u0627\u0644\u062a\u0639\u0631\u0636 \u0627\u0644\u062c\u0644\u062f\u064a \u0627\u0644\u0646\u0627\u0641\u0630",'glossary.term2.category':"\u0627\u0644\u062a\u0639\u0631\u0636",'glossary.term2.definition':"\u0625\u0635\u0627\u0628\u0629 \u062c\u0644\u062f\u064a\u0629 \u0646\u0627\u0641\u0630\u0629 \u0646\u0627\u062c\u0645\u0629 \u0639\u0646 \u0625\u0628\u0631\u0629 \u0645\u062c\u0648\u0641\u0629 \u0623\u0648 \u0645\u0634\u0631\u0637 \u062c\u0631\u0627\u062d\u064a \u0623\u0648 \u0623\u064a \u0623\u062f\u0627\u0629 \u062d\u0627\u062f\u0629 \u0645\u0644\u0648\u062b\u0629 \u0628\u0645\u0627\u062f\u0629 \u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629.",'glossary.term3.term':"\u0627\u0644\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u062e\u0627\u0