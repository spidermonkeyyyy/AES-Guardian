0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a \u0644\u0644\u0645\u0633\u062a\u0634\u0641\u0649.','onboarding.continue':'\u0645\u062a\u0627\u0628\u0639\u0629','onboarding.carousel.skip':'\u062a\u062e\u0637\u064a','onboarding.carousel.start':'\u0627\u0644\u0628\u062f\u0621','onboarding.carousel.next':'\u0627\u0644\u062a\u0627\u0644\u064a','onboarding.carousel.slide1.title':'\u0625\u0628\u0644\u0627\u063a \u0633\u0631\u064a\u0639 \u0648\u0645\u062d\u0645\u064a \u0639\u0646 \u0627\u0644\u062d\u0648\u0627\u062f\u062b','onboarding.carousel.slide1.desc':'\u0625\u0628\u0644\u0627\u063a \u0645\u0646\u0638\u0645 \u0641\u064a 5 \u062e\u0637\u0648\u0627\u062a \u0625\u0631\u0634\u0627\u062f\u064a\u0629 \u0641\u0648\u0631 \u0648\u0642\u0648\u0639 \u062d\u0627\u062f\u062b \u062a\u0639\u0631\u0636 \u0644\u0644\u062f\u0645\u060c \u0645\u0639 \u062d\u0641\u0638 \u0645\u062d\u0644\u064a \u0644\u0644\u0645\u0633\u0648\u062f\u0629.','onboarding.carousel.slide1.bullet1':'\u062d\u0641\u0638 \u0645\u062d\u0644\u064a \u0644\u0644\u0645\u0633\u0648\u062f\u0627\u062a','onboarding.carousel.slide1.bullet2':'\u0646\u0645\u0648\u0630\u062c \u0645\u0646\u0638\u0645 \u0641\u064a 5 \u062e\u0637\u0648\u0627\u062a \u0625\u0631\u0634\u0627\u062f\u064a\u0629','onboarding.carousel.slide1.bullet3':'\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0645\u064a\u0633\u0631 \u0644\u0644\u0645\u0633\u0648\u062f\u0629 \u0642\u064a\u062f \u0627\u0644\u0625\u0646\u062c\u0627\u0632','onboarding.carousel.slide2.title':'\u0645\u062a\u0627\u0628\u0639\u0629 \u062a\u0646\u0633\u064a\u0642 \u0633\u0631\u064a\u0629 \u0645\u0639 \u0637\u0628 \u0627\u0644\u0639\u0645\u0644','onboarding.carousel.slide2.desc':'\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0645\u0639 \u0637\u0628 \u0627\u0644\u0639\u0645\u0644 \u0645\u0639 \u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0639\u0631\u0648\u0636\u0629 \u0644\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0623\u062e\u0631\u0649 \u0648\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629.','onboarding.carousel.slide2.bullet1':'\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u062e\u0635\u0635\u0629 \u0644\u0637\u0628 \u0627\u0644\u0639\u0645\u0644','onboarding.carousel.slide2.bullet2':'\u062a\u062a\u0628\u0639 \u0645\u0631\u0627\u062d\u0644 \u0648\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0628\u0639\u062f \u0627\u0644\u062a\u0639\u0631\u0636','onboarding.carousel.slide2.bullet3':'\u0625\u0633\u0642\u0627\u0637 \u0645\u0642\u064a\u062f \u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0644\u0641 \u0644\u0644\u0645\u0647\u0646\u064a \u0627\u0644\u0645\u0639\u0631\u064e\u0651\u0636','onboarding.carousel.slide3.title':'\u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u0627\u0644\u0648\u0642\u0627\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0645\u0631\u0629','onboarding.carousel.slide3.desc':'\u0645\u0624\u0634\u0631\u0627\u062a \u0625\u062d\u0635\u0627\u0626\u064a\u0629 \u062a\u062c\u0645\u064a\u0639\u064a\u0629 \u0628\u062f\u0648\u0646 \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0639\u0631\u064a\u0641\u064a\u0629 \u0648\u0633\u062c\u0644 \u0645\u062d\u0644\u064a \u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0648\u0642\u0627\u064a\u0629 \u0648\u0627\u0644\u062a\u0635\u062d\u064a\u062d (CAPA).','onboarding.carousel.slide3.bullet1':'\u0645\u0624\u0634\u0631\u0627\u062a \u0645\u062c\u0645\u0639\u0629 \u0628\u062f\u0648\u0646 \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0634\u062e\u0635\u064a\u0629','onboarding.carousel.slide3.bullet2':'\u0633\u062c\u0644 \u0645\u0646\u0638\u0645 \u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0648\u0642\u0627\u064a\u0629 \u0648\u0627\u0644\u062a\u0635\u062d\u064a\u062d (CAPA)','onboarding.carousel.slide3.bullet3':'\u0641\u0635\u0644 \u0635\u0627\u0631\u0645 \u0644\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0648\u0641\u0642\u0627\u064b \u0644\u0644\u062f\u0648\u0631 \u0627\u0644\u0646\u0634\u0637','onboarding.disclaimer.title':'\u062a\u062d\u0630\u064a\u0631 \u2014 \u0646\u0645\u0648\u0630\u062c \u0623\u0648\u0644\u064a \u0644\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a','onboarding.disclaimer.badge':'\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0623\u0643\u0627\u062f\u064a\u0645\u064a \u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u062a\u062e\u0631\u062c','onboarding.disclaimer.p1':'1. \u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0646\u0645\u0648\u0630\u062c \u0623\u0648\u0644\u064a \u0644\u0644\u0628\u062d\u062b \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a (\u0645\u0634\u0631\u0648\u0639 \u062a\u062e\u0631\u062c). \u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u062d\u0648\u0627\u062f\u062b \u0648\u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0648\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0635\u0637\u0646\u0627\u0639\u064a\u0629 100%.','onboarding.disclaimer.p2':'2. \u0644\u0627 \u064a\u062a\u0645 \u062a\u062e\u0632\u064a\u0646 \u0623\u0648 \u0646\u0642\u0644 \u0623\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0637\u0628\u064a\u0629 \u062d\u0642\u064a\u0642\u064a\u0629. \u064a\u0639\u0645\u0644 \u0627\u0644\u0646\u0638\u0627\u0645 \u0645\u062d\u0644\u064a\u0627\u064b \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0639\u0628\u0631 \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a SQLite.','onboarding.disclaimer.p3':'3. \u0644\u0627 \u064a\u064f\u0639\u062a\u0628\u0631 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062c\u0647\u0627\u0632\u0627\u064b \u0637\u0628\u064a\u0627\u064b \u0645\u0639\u062a\u0645\u062f\u0627\u064b \u0648\u0644\u0627 \u064a\u0642\u0648\u0645 \u0628\u0623\u064a \u0641\u0631\u0632 \u0633\u0631\u064a\u0631\u064a \u062a\u0644\u0642\u0627\u0626\u064a \u0623\u0648 \u0648\u0635\u0641\u0627\u062a \u062f\u0648\u0627\u0626\u064a\u0629.','onboarding.disclaimer.p4':'4. \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a \u0644\u0627 \u064a\u062d\u0644 \u0645\u062d\u0644 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0637\u0628\u064a\u0629 \u0627\u0644\u0637\u0627\u0631\u0626\u0629. \u0641\u064a \u062d\u0627\u0644 \u062d\u062f\u0648\u062b \u062a\u0639\u0631\u0636 \u0641\u0639\u0644\u064a\u060c \u0627\u062a\u0628\u0639 \u0641\u0648\u0631\u0627\u064b \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0628\u0645\u0624\u0633\u0633\u062a\u0643 \u0648\u0627\u0633\u062a\u0634\u0631 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0639\u062c\u0644\u0629 \u062f\u0648\u0646 \u062a\u0623\u062e\u064a\u0631.','onboarding.disclaimer.checkbox':'\u0644\u0642\u062f \u0641\u0647\u0645\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 \u0644\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a \u0648\u0627\u0644\u0637\u0627\u0628\u0639 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a.','onboarding.disclaimer.accept':'\u0642\u0628\u0648\u0644 \u0648\u0645\u062a\u0627\u0628\u0639\u0629','onboarding.picker.title':'\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a','onboarding.picker.subtitle':'\u0627\u062e\u062a\u0631 \u0623\u062d\u062f \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u062e\u0645\u0633\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0644\u0645\u0639\u0627\u064a\u0646\u0629 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0648\u062d\u062f\u0648\u062f \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a.','onboarding.picker.syntheticNotice':'\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0635\u0637\u0646\u0627\u0639\u064a\u0629 \u0645\u062d\u0644\u064a\u0629 \u0628\u062f\u0648\u0646 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631. \u0627\u0644\u0631\u0645\u0648\u0632 \u0627\u0644\u062a\u0639\u0631\u064a\u0641\u064a\u0629 (\u0645\u062b\u0644 NURSE-001) \u0647\u064a \u0625\u0634\u0627\u0631\u0627\u062a \u062a\u0648\u0636\u064a\u062d\u064a\u0629 \u0644\u0644\u0645\u0642\u064a\u0651\u0645\u064a\u0646.','onboarding.picker.enter':'\u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644','onboarding.picker.role1.code':'NURSE-001','onboarding.picker.role1.title':'\u0627\u0644\u0645\u0647\u0646\u064a \u0627\u0644\u0635\u062d\u064a \u0627\u0644\u0645\u0639\u0631\u064e\u0651\u0636','onboarding.picker.role1.desc':'\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u062d\u0627\u062f\u062b \u062a\u0639\u0631\u0636 \u0648\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629.','onboarding.picker.role2.code':'ADMIN-001','onboarding.picker.role2.title':'\u0625\u0634\u0631\u0627\u0641 \u0627\u0644\u062a\u0645\u0631\u064a\u0636 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0631\u0639\u0627\u064a\u0629','onboarding.picker.role2.desc':'\u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629 \u0648\u0637\u0644\u0628 \u0627\u0644\u062a\u0635\u062d\u064a\u062d \u0648\u0627\u0644\u062a\u062d\u0642\u0642.','onboarding.picker.role3.code':'OCC-001','onboarding.picker.role3.title':'\u0627\u0644\u0635\u062d\u0629 \u0648\u0627\u0644\u0637\u0628 \u0627\u0644\u0645\u0647\u0646\u064a (SST)','onboarding.picker.role3.desc':'\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0637\u0628\u064a\u0629 \u0648\u0625\u062f\u0627\u0631\u0629 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0628\u0639\u062f \u0627\u0644\u062a\u0639\u0631\u0636.','onboarding.picker.role4.code':'QUAL-001','onboarding.picker.role4.title':'\u062e\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u0631','onboarding.picker.role4.desc':'\u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0648\u0628\u0627\u0626\u064a\u0629 \u0627\u0644\u062a\u062c\u0645\u064a\u0639\u064a\u0629 \u0648\u062e\u0637\u0629 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0648\u0642\u0627\u0626\u064a\u0629.','onboarding.picker.role5.code':'ADMIN-TECH','onboarding.picker.role5.title':'\u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062a\u0642\u0646\u064a\u0629','onboarding.picker.role5.desc':'\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0648\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a.','list.filter.all':'\u0627\u0644\u0643\u0644','list.filter.draft':'\u0627\u0644\u0645\u0633\u0648\u062f\u0627\u062a','list.filter.submitted':'\u0627\u0644\u0645\u0642\u062f\u0645\u0629','list.filter.under_review':'\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629','list.filter.closed':'\u0645\u063a\u0644\u0642\u0629','list.adminQueueShortcut':'\u0637\u0627\u0628\u0648\u0631 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629','list.restrictedTitle':'\u0648\u0635\u0648\u0644 \u0645\u0642\u064a\u062f','list.restrictedMessage':'\u062f\u0648\u0631\u0643 \u0644\u0627 \u064a\u0633\u0645\u062d \u0644\u0643 \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062a\u0635\u0631\u064a\u062d\u0627\u062a.','list.incidentType':'\u0646\u0648\u0639 \u0627\u0